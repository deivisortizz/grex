# --- Build Stage ---
FROM node:18-alpine AS build

WORKDIR /app

# Copiar os manifests primeiro para aproveitar cache de build
COPY package*.json ./
RUN npm install

# Copiar código-fonte e buildar
COPY . .
RUN npm run build

# --- Serve Stage ---
FROM nginx:alpine

# Copiar os arquivos gerados no stage anterior
COPY --from=build /app/dist /usr/share/nginx/html

# Ajustar as permissões, se necessário
RUN chmod -R 755 /usr/share/nginx/html

# Expor a porta 80 (padrão de Web/NGINX)
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
